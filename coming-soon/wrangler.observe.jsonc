// observe.gorbital.dev while its demo is down: the coming-soon page on every path.
// Generated by build.mjs. Deploy: npx -y wrangler@4 deploy --config coming-soon/wrangler.observe.jsonc
{
  "name": "gorbital-observe",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./out/observe",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "observe.gorbital.dev", "custom_domain": true }]
}
